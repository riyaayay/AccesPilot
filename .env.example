# AccessPilot Environment Configuration Template
# Copy to .env and provide real credentials if testing with external providers.

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accesspilot

# Hyperswitch Adapter Configuration (Sandbox)
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_API_KEY=
HYPERSWITCH_WEBHOOK_SECRET=

# LLM Providers for ap-agent (Optional - falls back to ScriptedPlanner if not set)
GROQ_API_KEY=
GEMINI_API_KEY=

# Server Configuration
GATEWAY_PORT=8080
RUST_LOG=info

